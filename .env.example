# Copy to .env for local runs. .env is gitignored — never commit real values.
# In GitHub Actions these are repository secrets instead.

# Email (Phase 5). Gmail: use an App Password, never the main account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# Live trading (Phase 6) — LOCKED OFF. Leave empty. See docs/SETUP.md before ever filling these.
# COPYBOT_LIVE=
# HL_API_WALLET_PRIVATE_KEY=
# HL_ACCOUNT_ADDRESS=
